# Firebase web app config (Project settings > General > Your apps > SDK setup and configuration).
# Copy to .env.local. It is read at build time, for local dev and for npm run deploy.
# These values identify the project to the browser; access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
